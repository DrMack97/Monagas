{
  "name": "@monagas/functions",
  "version": "2.0.0",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "pnpm --filter @monagas/core build && npm run build && cross-env FUNCTIONS_DISCOVERY_TIMEOUT=60 npx firebase emulators:exec --project well-testing-dev --only auth,firestore,functions \"jest\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@monagas/core": "workspace:*",
    "express": "^4.18.2",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.4.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "cross-env": "^7.0.3",
    "firebase-functions-test": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.4.5"
  },
  "private": true
}
