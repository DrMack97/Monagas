rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return request.auth.token.rol;
    }

    function isRoot()     { return getRole() == 'ROOT'; }
    function isGerente()  { return getRole() == 'GERENTE'; }
    function isSupArea() { return getRole() == 'SUP_AREA'; }
    function isSupCampo() { return getRole() == 'SUP_CAMPO'; }
    function isOperador() { return getRole() == 'OPERADOR'; }

    // Operador y Supervisor de Campo: acceso de lectura a UN (1) solo
    // pozo, el que tengan asignado en este momento (Custom Claim
    // `pozoAsignado`, singular). Se actualiza solo vía reassignPozo.ts
    function isAssignedToPozo(pozoId) {
      return request.auth.token.pozoAsignado == pozoId;
    }

    // Solo Supervisor de Área (SUP_AREA, en SU zona) y Gerente (sin
    // restricción) crean pozos nuevos y editan cualquier campo
    // (incluyendo nombre, zona, asignados[]) de un pozo o evaluación
    // ya existente. Antes existía una canManagePozos() sin chequeo de
    // zona en escritura — un SUP_AREA de FAJA podía escribir sobre un
    // pozo/evaluación de MONAGAS, algo que la regla de LECTURA
    // (canViewPozosEnZona) sí prohibía. Se unificó en esta única
    // función para que lectura y escritura respeten la misma zona.
    function canManagePozoEnZona(zona) {
      return isGerente() || (isSupArea() && request.auth.token.zona == zona);
    }

    // SUP_CAMPO puede editar SU propio pozo, pero únicamente los campos
    // técnicos de operación diaria: tanques (mi/ft) y límites de alerta
    // (limResorte/limGamma). No puede tocar nombre, zona, asignados[],
    // ni crear pozos nuevos — eso sigue siendo exclusivo de canManagePozoEnZona().
    // Tampoco tiene ninguna autoridad sobre creación o reasignación de
    // personal — eso vive exclusivamente en las Cloud Functions
    // crearPersonal.ts y reassignPozo.ts, restringidas a SUP_AREA/GERENTE.
    function canEditOwnTanquesYLimites(pozoId) {
      return isSupCampo() && isAssignedToPozo(pozoId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['tanques', 'limResorte', 'limGamma']);
    }

    // Candado de ciclo EN_CURSO (useEvaluacionActual.ts, mobile-operator).
    // El Operador resuelve su evalId con una runTransaction que lee y
    // escribe pozo.evalEnCursoId — es la única forma de que dos
    // pestañas/dispositivos compitiendo por el mismo pozo no terminen
    // creando dos evaluaciones EN_CURSO duplicadas. Solo ese campo,
    // nunca junto con otros: si alguien cuela más claves en la misma
    // escritura no es este candado, es otra cosa y no debe colar por
    // aquí. La liberación (id -> null) y la reapertura tras un rechazo
    // (null -> mismo id) las hacen las Cloud Functions con Admin SDK
    // (onEvalSubmit.ts / onReject.ts), no pasan por esta regla.
    function canManageOwnCicloEnCurso(pozoId) {
      return isOperador() && isAssignedToPozo(pozoId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evalEnCursoId']);
    }

    // SUP_AREA ve todos los pozos de SU zona; GERENTE ve todos sin restricción
    function canViewPozosEnZona(pozoZona) {
      return isGerente() || (isSupArea() && request.auth.token.zona == pozoZona);
    }

    // Aprobar/rechazar una evaluación (useApprovals.ts en web-supervisor).
    // Exige las tres cosas a la vez:
    //  - Rol correcto y en SU zona (canManagePozoEnZona)
    //  - Solo puede tocar estado + aprobaciones — nada de reescribir
    //    resultados, pozoId, horasEvaluadas, etc. de paso
    //  - Solo desde PENDIENTE_SUPERVISOR hacia APROBADA_SUPERVISOR
    //    (aprobar) o EN_CURSO (rechazar) — ningún otro salto de estado
    function canApproveEvaluacion(evalZona) {
      return canManagePozoEnZona(evalZona) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'aprobaciones']) &&
        resource.data.estado == 'PENDIENTE_SUPERVISOR' &&
        request.resource.data.estado in ['APROBADA_SUPERVISOR', 'EN_CURSO'];
    }

    // El Operador solo puede tocar estos campos de SU PROPIA evaluación
    // EN_CURSO — registrar horas (RegistroPage.tsx) o cerrar el ciclo
    // hacia PENDIENTE_SUPERVISOR con sus resultados (ReportePage.tsx).
    function canUpdateOwnEvaluacion() {
      return isOperador() &&
        resource.data.operadorId == request.auth.uid &&
        resource.data.estado == 'EN_CURSO' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['horasEvaluadas', 'resultados', 'estado', 'fechaCierre']);
    }

    // Corrección de una lectura individual por el Supervisor (drill-down
    // de ApprovalQueuePage.tsx). Requiere un get() a la evaluación padre
    // porque la lectura en sí no trae zona/estado. Solo mientras la
    // evaluación esté PENDIENTE_SUPERVISOR — una vez aprobada/rechazada,
    // las lecturas quedan congeladas. hora/timestamp/alertas quedan
    // fuera de hasOnly() a propósito: son metadata de cuándo se tomó la
    // lectura, no valores medidos — no se "corrigen", son un hecho.
    function canEditLectura(evalId) {
      let evaluacion = get(/databases/$(database)/documents/evaluaciones/$(evalId)).data;
      return canManagePozoEnZona(evaluacion.zona) &&
        evaluacion.estado == 'PENDIENTE_SUPERVISOR' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tanques', 'operativos', 'gas']);
    }

    // /usuarios/{uid} — perfil del usuario
    // Escritura directa restringida a ROOT. Toda alta o reasignación de
    // personal pasa por Cloud Functions dedicadas (crearPersonal.ts,
    // reassignPozo.ts), exclusivas de SUP_AREA/GERENTE — usan Admin SDK
    // y refrescan el Custom Claim al mismo tiempo. SUP_CAMPO no tiene
    // autoridad sobre personal: no elige el equipo con el que trabaja.
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      // Excepción puntual: cualquier usuario autenticado puede guardar
      // SU PROPIO token de FCM (útil para notificaciones push, ver
      // useNotifications.ts) — nada más. Todo lo demás (rol, zona,
      // pozoAsignado, activo) sigue exclusivo de ROOT / Cloud Functions.
      allow write: if isRoot() ||
        (request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']));
    }

    // /pozos/{pozoId} — configuración de pozos
    match /pozos/{pozoId} {
      allow read: if isRoot()
        || canViewPozosEnZona(resource.data.zona)
        || isAssignedToPozo(pozoId);
      // create: no hay resource.data (el pozo no existe todavía) — se
      // valida contra la zona que trae el propio documento nuevo.
      allow create: if isRoot() || canManagePozoEnZona(request.resource.data.zona);
      allow update: if isRoot() || canManagePozoEnZona(resource.data.zona) || canEditOwnTanquesYLimites(pozoId) || canManageOwnCicloEnCurso(pozoId);
      allow delete: if isRoot();
    }

    // /evaluaciones/{evalId} — sesiones de medición
    match /evaluaciones/{evalId} {
      allow read: if isRoot()
        || canViewPozosEnZona(resource.data.zona)
        || isAssignedToPozo(resource.data.pozoId);
      allow create: if isRoot() ||
        (isOperador() && isAssignedToPozo(request.resource.data.pozoId));
      // SUP_CAMPO quitado — no tiene ningún flujo real que escriba
      // evaluaciones (ver WellDetailPage.tsx: solo toca /pozos). Antes
      // podía editar cualquier evaluación sin restricción alguna.
      allow update: if isRoot()
        || canApproveEvaluacion(resource.data.zona)
        || canUpdateOwnEvaluacion();
      allow delete: if isRoot();

      // /evaluaciones/{evalId}/lecturas/{lecturaId}
      match /lecturas/{lecturaId} {
        allow read: if request.auth != null;
        allow create: if isRoot() ||
          (isOperador() &&
           get(/databases/$(database)/documents/evaluaciones/$(evalId)).data.operadorId == request.auth.uid);
        allow update: if isRoot() || canEditLectura(evalId);
        allow delete: if isRoot();
      }
    }

    // /logs/{logId} — auditoría, solo lectura/escritura de sistema
    match /logs/{logId} {
      allow read: if isRoot();
      allow write: if false; // solo Cloud Functions con Admin SDK
    }
  }
}
